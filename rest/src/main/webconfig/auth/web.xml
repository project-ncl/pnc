<web-app xmlns="http://java.sun.com/xml/ns/javaee"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
      version="3.0">

    <module-name>rest</module-name>

    <session-config>
        <session-timeout>600</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>true</secure>
            <max-age>36000</max-age>
        </cookie-config>
    </session-config>

    <login-config>
        <!-- EAPSUP-2073: setup to support both LDAP and OIDC -->
        <auth-method>BASIC?silent=true,OIDC</auth-method>
    </login-config>
    <listener>
        <!-- EAPSUP-2073: setup to support both LDAP and OIDC -->
        <listener-class>org.wildfly.security.http.oidc.OidcConfigurationServletListener</listener-class>
    </listener>
    <listener>
        <listener-class>org.jboss.pnc.rest.OidcConnectionTtlListener</listener-class>
    </listener>
    <security-role>
        <role-name>pnc-users</role-name>
    </security-role>
    <security-role>
        <role-name>pnc-app-build-delete</role-name>
    </security-role>
    <security-role>
        <role-name>pnc-app-build-user</role-name>
    </security-role>
    <security-role>
        <role-name>pnc-app-artifact-user</role-name>
    </security-role>
    <security-role>
        <role-name>pnc-app-environment-user</role-name>
    </security-role>
    <security-role>
        <role-name>pnc-app-attachment-user</role-name>
    </security-role>
    <security-role>
        <role-name>pnc-users-admin</role-name>
    </security-role>
    <security-role>
        <!-- temporarily add it for attachment -->
        <role-name>pnc-app-rex-user</role-name>
    </security-role>

    <!-- make sure interceptor sees this and redirect user to sso server -->
    <!-- the rest is handled inside the SecurityConstraintFilter -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Login with redirect</web-resource-name>
            <url-pattern>/v2/users/login/*</url-pattern>
            <http-method>GET</http-method>
        </web-resource-collection>
        <auth-constraint>
            <role-name>**</role-name>
        </auth-constraint>
    </security-constraint>

    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Logout with redirect</web-resource-name>
            <url-pattern>/v2/users/logout/*</url-pattern>
            <http-method>GET</http-method>
        </web-resource-collection>
        <auth-constraint>
            <role-name>**</role-name>
        </auth-constraint>
    </security-constraint>

    <!-- Allow unauthenticated access to /users/current so SecurityConstraintFilter can return 401 -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Current user without redirect</web-resource-name>
            <url-pattern>/v2/users/current/*</url-pattern>
            <http-method>GET</http-method>
        </web-resource-collection>
    </security-constraint>
</web-app>

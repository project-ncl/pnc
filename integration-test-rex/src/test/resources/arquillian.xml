<arquillian xmlns="http://jboss.org/schema/arquillian"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://jboss.org/schema/arquillian http://jboss.org/schema/arquillian/arquillian_1_0.xsd">

    <container qualifier="jboss" default="true">
        <configuration>
            <property name="jbossHome">${test.server.build.dir}</property>
            <property name="javaVmArguments">-Xmx2G --add-modules=java.se -Dpnc-config-file=${test.server.build.dir}/pnc-config.json</property>
<!--             <property name="javaVmArguments">-Xmx2G &#45;&#45;add-modules=java.se -Dpnc-config-file=${test.server.build.dir}/pnc-config.json -Xrunjdwp:transport=dt_socket,address=1044,server=y,suspend=y</property>-->
        </configuration>
    </container>

    <extension qualifier="jacoco">
        <property name="includes">org.jboss.pnc.*</property>
    </extension>

</arquillian>
